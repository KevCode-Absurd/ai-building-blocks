{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "site",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "site",
        "run",
        "dev"
      ],
      "port": 5180
    },
    {
      "name": "site-vite",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "site/node_modules/vite/bin/vite.js",
        "site",
        "--port",
        "5181",
        "--strictPort"
      ],
      "port": 5181
    },
    {
      "name": "agents-worker",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "marketplace/node_modules/wrangler/bin/wrangler.js",
        "dev",
        "--config",
        "marketplace/wrangler.jsonc",
        "--port",
        "5290"
      ],
      "port": 5290
    }
  ]
}
