# Keep executable pack sources identical to LF-normalized exports on every checkout.
/marketplace/packs/shared/tools/*.mjs text eol=lf
/marketplace/src/modules/packs/retrieve.ts text eol=lf

# Public download and inline-script bytes must be stable across checkouts.
/site/public/playbooks/*.md text eol=lf
/site/index.html text eol=lf
/site/src/PageRecovery.tsx text eol=lf
/catalogue-items/general/grounded-job-protocol/SKILL.md text eol=lf

# Published benchmark downloads: their SHA-256 values are printed in the article and results.json.
/site/public/blog-assets/** -text
