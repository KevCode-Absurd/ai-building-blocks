      "id": "borrow_rate",
      "label": "borrow rate",
      "value": 0.05,
      "unit": "annual decimal",
      "min": 0,
      "max": 1
    },
    {
      "id": "days",
      "label": "days",
      "value": 30,
      "unit": "days",
      "min": 0,
      "max": 366
    },
    {
      "id": "basis",
      "label": "basis",
      "value": 360,
      "unit": "days / year",
      "min": 1,
      "max": 366
    }
  ],
  "calculations": [
    {
      "id": "fraction",
      "label": "fraction",
      "op": "div",
      "args": [
        "days",
        "basis"
      ],
      "unit": "year fraction"
    },
    {
      "id": "deposit_interest",
      "label": "deposit interest",
      "op": "mul",
      "args": [
        "deposit_principal",
        "deposit_rate",
        "fraction"
      ],
      "unit": "USD / stated period"
    },
    {
      "id": "borrow_interest",
      "label": "borrow interest",
      "op": "mul",
      "args": [
        "borrow_principal",
        "borrow_rate",
        "fraction"
      ],
      "unit": "USD / stated period"
    },
    {
      "id": "center_residual",
      "label": "center residual",
      "op": "sub",
      "args": [
        "borrow_interest",
        "deposit_interest"
      ],
      "unit": "USD / stated period"
    }
  ],
  "outputs": [
    "deposit_interest",
    "borrow_interest",
    "center_residual"
  ],
