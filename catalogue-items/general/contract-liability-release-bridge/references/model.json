      "unit": "USD million",
      "min": 0.001,
      "max": 1000000000
    }
  ],
  "calculations": [
    {
      "id": "available",
      "label": "Liability before revenue releases",
      "op": "add",
      "args": [
        "opening",
        "additions",
        "other"
      ],
      "unit": "USD million"
    },
    {
      "id": "release",
      "label": "Inferred revenue release",
      "op": "sub",
      "args": [
        "available",
        "closing"
      ],
      "unit": "USD million"
    },
    {
      "id": "residual",
      "label": "Disclosed less inferred release",
      "op": "sub",
      "args": [
        "disclosedRelease",
        "release"
      ],
      "unit": "USD million"
    },
    {
      "id": "releaseShare",
      "label": "Release as share of total revenue",
      "op": "div",
      "args": [
        "release",
        "totalRevenue"
      ],
      "unit": "decimal"
    }
  ],
  "outputs": [
    "release",
    "residual",
    "releaseShare"
  ],
  "expected": {
    "release": 60,
    "residual": 0,
    "releaseShare": 0.4
  },
