    {
      "id": "closing",
      "label": "Closing contract liability",
      "value": 120,
      "unit": "USD million",
      "min": 0,
      "max": 1000000000
    },
    {
      "id": "disclosedRelease",
      "label": "Disclosed total release",
      "value": 60,
