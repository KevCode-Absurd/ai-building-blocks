      "max": 1
    },
    {
      "id": "appraised_nolv",
      "label": "appraised nolv",
      "value": 800,
      "unit": "USD / stated period",
      "min": 0
    },
    {
      "id": "nolv_advance_rate",
      "label": "nolv advance rate",
      "value": 0.7,
      "unit": "decimal fraction",
      "min": 0,
      "max": 1
    },
    {
      "id": "sublimit",
      "label": "sublimit",
      "value": 600,
      "unit": "USD / stated period",
      "min": 0
    },
    {
      "id": "reserve",
      "label": "reserve",
      "value": 50,
      "unit": "USD / stated period",
      "min": 0
    }
  ],
  "calculations": [
    {
      "id": "cost_cap",
      "label": "cost cap",
      "op": "mul",
      "args": [
        "eligible_cost",
        "cost_advance_rate"
      ],
      "unit": "USD / stated period"
    },
    {
      "id": "appraisal_cap",
      "label": "appraisal cap",
      "op": "mul",
      "args": [
        "appraised_nolv",
        "nolv_advance_rate"
      ],
      "unit": "USD / stated period"
    },
    {
      "id": "advance_before_reserve",
      "label": "advance before reserve",
      "op": "min",
      "args": [
        "cost_cap",
        "appraisal_cap",
        "sublimit"
      ],
      "unit": "USD / stated period"
    },
    {
      "id": "signed_advance",
      "label": "signed advance",
      "op": "sub",
      "args": [
        "advance_before_reserve",
        "reserve"
      ],
      "unit": "USD / stated period"
    },
    {
      "id": "net_advance",
      "label": "net advance",
      "op": "max",
      "args": [
        0,
        "signed_advance"
      ],
      "unit": "USD / stated period"
    }
  ],
  "outputs": [
    "cost_cap",
    "appraisal_cap",
    "advance_before_reserve",
    "net_advance"
  ],
  "expected": {
    "cost_cap": 500,
