      "op": "sub",
      "args": [
        "grossCost",
        "proceeds"
      ],
      "unit": "USD million"
    },
    {
      "id": "difference",
      "label": "Net cash cost less accounting expense",
      "op": "sub",
      "args": [
        "netCashCost",
        "reportedSbc"
      ],
      "unit": "USD million"
    }
  ],
  "outputs": [
    "grossCost",
    "netCashCost",
    "difference"
  ],
  "expected": {
    "grossCost": 60,
    "netCashCost": 50,
    "difference": 10
  },
  "cases": [
    {
      "name": "Lower repurchase price scenario",
