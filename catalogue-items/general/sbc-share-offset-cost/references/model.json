      "max": 1000000000
    },
    {
      "id": "proceeds",
      "label": "Employee exercise proceeds",
      "value": 10,
      "unit": "USD million",
      "min": 0,
      "max": 1000000000
    },
    {
      "id": "reportedSbc",
      "label": "Reported compensation expense",
      "value": 40,
      "unit": "USD million",
      "min": 0,
      "max": 1000000000
    }
  ],
  "calculations": [
    {
      "id": "grossCost",
      "label": "Gross share-offset cash",
      "op": "mul",
      "args": [
        "issuedShares",
        "price"
      ],
      "unit": "USD million"
    },
    {
      "id": "netCashCost",
