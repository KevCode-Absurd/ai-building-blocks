{
  "name": "ai-building-blocks-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "index": "node scripts/build-index.mjs && node scripts/build-ai-tools.mjs && node ../tools/build-mini-tool.mjs && node ../tools/check-masking.mjs",
    "dev": "npm run index && vite",
    "build": "npm run index && tsc -b && vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "crawl": "node scripts/crawl.mjs",
    "seo": "node scripts/check-seo.mjs",
    "test:e2e": "playwright test",
    "test:unit": "node --test test/comments.test.mjs test/spaces.test.mjs test/traction.test.mjs"
  },
  "dependencies": {
    "@xyflow/react": "12.3.6",
    "fflate": "0.8.2",
    "preact": "10.29.7",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@preact/preset-vite": "2.10.6",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "d3-geo": "3.1.1",
    "marked": "14.1.4",
    "sharp": "^0.34.4",
    "topojson-client": "3.1.0",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "world-atlas": "2.0.2",
    "yaml": "2.6.1"
  }
}
