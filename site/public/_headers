# Account, sign-in and publishing pages are never shown inside another site's frame (clickjacking).
/account
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
/account/*
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
/space
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
/space/*
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
/sign-in
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
/sign-in/*
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
/sign-up
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
/sign-up/*
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
/publish
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
/publish/*
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
/my-submissions
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
/my-submissions/*
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
/admin
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
/admin/*
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'

# Preview images change rarely.
/support-chat-frame.html
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: frame-ancestors 'self'; base-uri 'self'
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex, nofollow
/support-chat-frame
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: frame-ancestors 'self'; base-uri 'self'
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex, nofollow
/support-chat*.js
  Cache-Control: public, max-age=0, must-revalidate
/support-chat.css
  Cache-Control: public, max-age=0, must-revalidate

# The feeds of new and changed items (scripts/build-index.mjs): any feed reader or AI may read them.
/feed.json
  Cache-Control: public, max-age=900, stale-while-revalidate=86400
  Access-Control-Allow-Origin: *
/feed.xml
  Cache-Control: public, max-age=900, stale-while-revalidate=86400
  Access-Control-Allow-Origin: *

# Preview images change rarely.
/og/*
  Cache-Control: public, max-age=86400

# Supporting package files are downloads, never executable pages on this origin.
# These paths have at least three segments; public item pages keep their normal headers.
/skills/:slug/:file
  Content-Disposition: attachment
  X-Robots-Tag: noindex
  Content-Security-Policy: sandbox; default-src 'none'; frame-ancestors 'none'
/skills/:slug/:directory/*
  Content-Disposition: attachment
  X-Robots-Tag: noindex
  Content-Security-Policy: sandbox; default-src 'none'; frame-ancestors 'none'
