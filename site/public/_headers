# Cache rules for Cloudflare Pages (useaiblocks.com).
# Code and styles have a hash in their names, so a new build gets new names: keep them for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts never change.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# The library, skills and pages change with each build: use the copy you have, check for a new one in the background.
/data/*
  Cache-Control: public, max-age=300, stale-while-revalidate=86400
  X-Robots-Tag: noindex
/metadata/*
  Cache-Control: public, max-age=300, must-revalidate
  X-Robots-Tag: noindex
/mini-tools/*
  X-Robots-Tag: noindex
/example-app
  X-Robots-Tag: noindex
/example-app/*
  X-Robots-Tag: noindex
/space
  X-Robots-Tag: noindex, nofollow
/s/*
  X-Robots-Tag: noindex, nofollow
# Item pages point at hashed code files: a browser may use its copy for 5 minutes, then a stale copy for at most
# 10 more while it fetches the new one, so a page never outlives the code it names by long after a deploy.
/skills/*
  Cache-Control: public, max-age=300, stale-while-revalidate=600
# The skill files and zips are for downloading and for AI assistants; the page for each skill is what search shows.
/skills/:slug/SKILL.md
  X-Robots-Tag: noindex
/skills/*.zip
  X-Robots-Tag: noindex

# Safer defaults on every response. The mini tools' embed pages are meant to sit in other sites' iframes, so no
# frame rule is set here.
# Consent must never be embeddable, including its direct static aliases.
/connect-mcp
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  Cache-Control: private, no-store
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex, nofollow
/connect-mcp.html
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  Cache-Control: private, no-store
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex, nofollow
# Strict-Transport-Security: browsers use HTTPS only, for a year, on this domain and its subdomains.
# Content-Security-Policy-Report-Only enforces nothing yet: browsers report what it would block to /api/client-error
# (Workers Logs, docs/MONITORING.md). The sha256 values are index.html's three inline scripts and the home page's
# four (scripts/build-home-initial-shell.mjs). site/test/security-headers.test.mjs checks the first three; the release
# gate (scripts/byte-budgets.mjs) checks built pages and prints any missing hash. Enforce only after a week of reports
# shows nothing real blocked.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(self), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
