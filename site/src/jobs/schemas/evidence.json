{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://useaiblocks.com/api/v1/schemas/ai-blocks-evidence/1.json",
  "title": "ai-blocks-evidence/1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "ai-blocks-evidence/1"
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,119}$"
          },
          "claim": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "status": {
            "type": "string",
            "enum": [
              "CONFIRMED",
              "INFERRED",
              "DISPUTED",
              "UNKNOWN"
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "checked_by": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,119}$"
          },
          "used_in": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,119}$"
            },
            "minItems": 0,
            "maxItems": 1000,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "claim",
          "status",
          "source",
          "checked_by",
          "used_in"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 1000
    }
  },
  "required": [
    "schema",
    "claims"
  ],
  "additionalProperties": false
}
