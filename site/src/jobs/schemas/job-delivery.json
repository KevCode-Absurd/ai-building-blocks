{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://useaiblocks.com/api/v1/schemas/ai-blocks-job-delivery/1.json",
  "title": "ai-blocks-job-delivery/1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "ai-blocks-job-delivery/1"
    },
    "job_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,119}$"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "content": {
            "type": "string",
            "minLength": 0,
            "maxLength": 200000
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "revision_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false
      },
      "minItems": 6,
      "maxItems": 1000
    },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slot_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,119}$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "family": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[a-z0-9][a-z0-9-]{0,119}$"
          },
          "maker_seat": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,119}$"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "slug": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120,
                  "pattern": "^[a-z0-9][a-z0-9-]{0,119}$"
                },
                "revision_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "slug",
                "revision_sha256"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 100
          },
          "producer_note": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "content": {
            "type": "string",
            "minLength": 0,
            "maxLength": 200000
          },
          "claims": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,119}$"
            },
            "minItems": 0,
            "maxItems": 1000,
            "uniqueItems": true
          },
          "kind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "required": [
          "slot_id",
          "path",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 1000
    },
    "flags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "minItems": 0,
      "maxItems": 100
    },
    "open_flags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "minItems": 0,
      "maxItems": 100
    },
    "revision_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "enum": [
        "DELIVERED",
        "DELIVERED_WITH_FLAGS"
      ]
    },
    "accept_remaining_failures": {
      "type": "boolean"
    },
    "coordinator_review": {
      "type": "object",
      "properties": {
        "by_seat": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,119}$"
        },
        "job_match": {
          "type": "boolean"
        },
        "rubric_checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "passed": {
                "type": "boolean"
              },
              "notes": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              }
            },
            "required": [
              "id",
              "passed",
              "notes"
            ],
            "additionalProperties": false
          },
          "maxItems": 100
        },
        "notes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      },
      "required": [
        "by_seat",
        "job_match",
        "rubric_checks",
        "notes"
      ],
      "additionalProperties": false
    },
    "delivery_root": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "description": "Relative directory containing the required delivery metadata files. Artifact paths remain relative to the run root. Omit for the legacy flat or delivery/ layout."
    }
  },
  "required": [
    "schema",
    "files",
    "deliverables"
  ],
  "additionalProperties": false
}
