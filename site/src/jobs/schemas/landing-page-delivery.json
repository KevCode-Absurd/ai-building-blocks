{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://useaiblocks.com/api/v1/schemas/ai-blocks-landing-page-delivery/1.json",
  "title": "ai-blocks-landing-page-delivery/1",
  "description": "Current-source, host-reported implementation evidence. This record does not execute checks or certify performance.",
  "type": "object",
  "required": ["schema", "mode", "artifacts"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "ai-blocks-landing-page-delivery/1"},
    "mode": {"enum": ["LAUNCHABLE_SITE", "DESIGN_REFERENCE"]},
    "artifacts": {
      "type": "array", "maxItems": 1000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["slot_id", "source", "existing_site", "brand", "checks", "limitations"],
        "properties": {
          "slot_id": {"type": "string", "minLength": 1, "maxLength": 120},
          "source": {
            "type": "object", "additionalProperties": false,
            "required": ["path", "sha256", "entrypoint", "build_command", "preview_command"],
            "properties": {
              "path": {"type": "string", "minLength": 1, "maxLength": 240},
              "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "entrypoint": {"type": "string", "minLength": 1, "maxLength": 240},
              "build_command": {"type": "string", "minLength": 1, "maxLength": 2000},
              "preview_command": {"type": "string", "minLength": 1, "maxLength": 2000}
            }
          },
          "existing_site": {
            "type": "object", "additionalProperties": false,
            "required": ["status", "evidence", "rationale", "integration_target", "reused_components"],
            "properties": {
              "status": {"enum": ["REUSED", "ADAPTED", "GREENFIELD"]},
              "url": {"type": "string", "maxLength": 2000},
              "evidence": {"type": "string", "minLength": 1, "maxLength": 4000},
              "rationale": {"type": "string", "minLength": 1, "maxLength": 4000},
              "integration_target": {"type": "string", "minLength": 1, "maxLength": 2000},
              "reused_components": {"type": "array", "maxItems": 100, "items": {"type": "string", "minLength": 1, "maxLength": 1000}}
            }
          },
          "brand": {
            "type": "object", "additionalProperties": false,
            "required": ["brain_ref", "font_refs", "asset_refs", "evidence"],
            "properties": {
              "brain_ref": {"type": "string", "minLength": 1, "maxLength": 2000},
              "font_refs": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"type": "string", "minLength": 1, "maxLength": 2000}},
              "asset_refs": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"type": "string", "minLength": 1, "maxLength": 2000}},
              "evidence": {"type": "string", "minLength": 1, "maxLength": 4000}
            }
          },
          "checks": {
            "type": "array", "minItems": 1, "maxItems": 100,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["id", "status", "source_sha256", "receipt", "observed"],
              "properties": {
                "id": {"enum": ["build", "primary_action", "links_assets", "responsive", "keyboard_accessibility", "brand_content"]},
                "status": {"enum": ["PASS", "FAIL", "NOT_RUN", "BLOCKED"]},
                "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
                "receipt": {"type": "string", "minLength": 1, "maxLength": 2000},
                "observed": {"type": "string", "minLength": 1, "maxLength": 4000},
                "viewport": {
                  "type": "object", "additionalProperties": false, "required": ["width", "height"],
                  "properties": {"width": {"type": "integer", "minimum": 1, "maximum": 16384}, "height": {"type": "integer", "minimum": 1, "maximum": 16384}}
                }
              }
            }
          },
          "limitations": {"type": "array", "maxItems": 100, "items": {"type": "string", "minLength": 1, "maxLength": 2000}}
        }
      }
    }
  }
}
