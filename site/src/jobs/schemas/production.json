{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://useaiblocks.com/api/v1/schemas/ai-blocks-production/1.json",
  "title": "ai-blocks-production/1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "ai-blocks-production/1"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slot_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,119}$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "family": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[a-z0-9][a-z0-9-]{0,119}$"
          },
          "maker_seat": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,119}$"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "slug": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120,
                  "pattern": "^[a-z0-9][a-z0-9-]{0,119}$"
                },
                "revision_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "slug",
                "revision_sha256"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 100
          },
          "producer_note": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "content": {
            "type": "string",
            "minLength": 0,
            "maxLength": 200000
          },
          "claims": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,119}$"
            },
            "minItems": 0,
            "maxItems": 1000,
            "uniqueItems": true
          },
          "modality": {
            "enum": [
              "image",
              "video",
              "audio",
              "text",
              "3d",
              "interactive",
              "doc",
              "data"
            ]
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,119}$"
                },
                "status": {
                  "enum": [
                    "PASS",
                    "FAIL",
                    "NOT_RUN",
                    "BLOCKED"
                  ]
                },
                "notes": {
                  "type": "string",
                  "maxLength": 4000
                }
              },
              "required": [
                "id",
                "status"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 100
          },
          "budget": {
            "type": "object",
            "properties": {
              "used": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 10000,
                "description": "Measured total tool calls, or null when the host does not expose that total. Do not substitute render/process counts."
              },
              "allowance": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000
              },
              "reason": {
                "type": "string",
                "maxLength": 4000
              },
              "usage_status": {
                "type": "string",
                "enum": [
                  "MEASURED",
                  "NOT_AVAILABLE"
                ]
              }
            },
            "required": [
              "used",
              "allowance"
            ],
            "additionalProperties": false
          },
          "kind": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "method_amendments": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "properties": {
                "slug": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]{0,119}$"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                }
              },
              "required": [
                "slug",
                "reason"
              ],
              "additionalProperties": false
            }
          },
          "contributor_seats": {
            "type": "array",
            "maxItems": 12,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,119}$"
            }
          }
        },
        "required": [
          "slot_id",
          "path",
          "sha256",
          "maker_seat",
          "family",
          "modality",
          "items",
          "claims",
          "checks",
          "producer_note",
          "budget",
          "kind"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 1000
    },
    "evidence": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://useaiblocks.com/api/v1/schemas/ai-blocks-evidence/1.json",
      "title": "ai-blocks-evidence/1",
      "type": "object",
      "properties": {
        "schema": {
          "const": "ai-blocks-evidence/1"
        },
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,119}$"
              },
              "claim": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "status": {
                "type": "string",
                "enum": [
                  "CONFIRMED",
                  "INFERRED",
                  "DISPUTED",
                  "UNKNOWN"
                ]
              },
              "source": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "checked_by": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,119}$"
              },
              "used_in": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,119}$"
                },
                "minItems": 0,
                "maxItems": 1000,
                "uniqueItems": true
              }
            },
            "required": [
              "id",
              "claim",
              "status",
              "source",
              "checked_by",
              "used_in"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 1000
        }
      },
      "required": [
        "schema",
        "claims"
      ],
      "additionalProperties": false
    },
    "lead_review": {
      "type": "object",
      "properties": {
        "by_seat": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,119}$"
        },
        "status": {
          "enum": [
            "PASS",
            "REVISE"
          ]
        },
        "notes": {
          "type": "string",
          "maxLength": 4000
        }
      },
      "required": [
        "by_seat",
        "status",
        "notes"
      ],
      "additionalProperties": false
    },
    "visual_review": {
      "type": "object",
      "description": "Host-reported independent visual comparison, not a guarantee of quality.",
      "properties": {
        "renderer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "receipt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "by_seat": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "type": "object",
            "properties": {
              "slot_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "status": {
                "enum": [
                  "PASS",
                  "FAIL"
                ]
              },
              "reference_comparison": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "spec_comparison": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "required": [
              "slot_id",
              "status",
              "reference_comparison",
              "spec_comparison"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "renderer",
        "receipt",
        "by_seat",
        "items"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "artifacts",
    "evidence",
    "lead_review"
  ],
  "additionalProperties": false
}
