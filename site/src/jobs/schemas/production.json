      "type": "object",
      "description": "Host-reported independent visual comparison, not a guarantee of quality.",
      "properties": {
        "renderer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "receipt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "by_seat": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "type": "object",
            "properties": {
              "slot_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "status": {
                "enum": [
                  "PASS",
                  "FAIL"
                ]
              },
              "reference_comparison": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "spec_comparison": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "checks": {
                "type": "array",
                "minItems": 1,
                "maxItems": 20,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "status",
                    "receipt",
                    "observed"
                  ],
                  "properties": {
                    "id": {
                      "enum": [
                        "brand",
                        "product_fidelity",
                        "claims_copy",
                        "format"
                      ]
                    },
                    "status": {
                      "enum": [
                        "PASS",
                        "FAIL",
                        "NOT_RUN",
                        "BLOCKED"
                      ]
                    },
                    "receipt": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000
                    },
                    "observed": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000
                    }
                  }
                }
              },
              "compared_with": {
                "type": "array",
