              },
              "claim": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "status": {
                "type": "string",
                "enum": [
                  "CONFIRMED",
                  "INFERRED",
                  "DISPUTED",
                  "UNKNOWN"
                ]
              },
              "source": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "checked_by": {
                "type": "string",
