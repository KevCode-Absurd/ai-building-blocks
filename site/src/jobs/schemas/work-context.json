{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://useaiblocks.com/api/v1/schemas/ai-blocks-work-context/1.json",
  "title": "ai-blocks-work-context/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "mode",
    "sources",
    "preserve",
    "changes",
    "comparison"
  ],
  "properties": {
    "schema": {
      "const": "ai-blocks-work-context/1"
    },
    "mode": {
      "enum": [
        "CREATE",
        "IMPROVE",
        "ASSESS"
      ]
    },
    "scope_reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "sources": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "ref",
          "sha256",
          "observed_at",
          "role",
          "currentness",
          "freshness_basis",
          "observations",
          "receipt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "observed_at": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "role": {
            "enum": [
              "BASELINE",
              "REFERENCE"
            ]
          },
          "currentness": {
            "enum": [
              "CURRENT",
              "STALE",
              "UNKNOWN"
            ]
          },
          "freshness_basis": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "observations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          },
          "receipt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        }
      }
    },
    "preserve": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule",
          "source_id"
        ],
        "properties": {
          "rule": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "source_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        }
      }
    },
    "changes": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "problem",
          "source_ids",
          "proposed_change",
          "expected_effect",
          "verification"
        ],
        "properties": {
          "problem": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 30,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          },
          "proposed_change": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "expected_effect": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "verification": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "request_review",
        "artifacts",
        "criteria"
      ],
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "request_review": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "observation",
            "receipt"
          ],
          "properties": {
            "observation": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "receipt": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            }
          }
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256",
              "source_id"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "source_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
            }
          }
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "artifact_path",
              "artifact_sha256",
              "status",
              "observation",
              "receipt"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "artifact_path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "artifact_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "status": {
                "enum": [
                  "PASS",
                  "FAIL",
                  "NOT_RUN"
                ]
              },
              "observation": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "receipt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              }
            }
          }
        }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "pass_condition",
        "unmeasured"
      ],
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "pass_condition": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "unmeasured": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "results": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "criterion",
              "baseline_observation",
              "result_observation",
              "status",
              "receipt",
              "artifact_sha256"
            ],
            "properties": {
              "criterion": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "baseline_observation": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "result_observation": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "status": {
                "enum": [
                  "PASS",
                  "FAIL",
                  "NOT_RUN"
                ]
              },
              "receipt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "artifact_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    }
  }
}
